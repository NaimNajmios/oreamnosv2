<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- In-app update downloads (the install source, kept app-private).
         - <external-files-path path="Download"> is the app's downloads dir on
           Android (path_provider getDownloadsDirectory() resolves to
           /storage/emulated/0/Android/data/com.najmi.oreamnos/files/Download).
         - <cache-path path="updates/"> is the fallback location when the
           system reports no downloads directory.
         The user-visible copy in the public Download folder is written via
         MediaStore.Downloads, which FileProvider cannot serve. -->
    <external-files-path name="app_files" path="Download" />
    <cache-path name="update_cache" path="updates/" />
</paths>
