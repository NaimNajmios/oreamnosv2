<?xml version="1.0" encoding="utf-8"?>
<!-- Last post, row (one cell tall): the elapsed time on a single line. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="#1C1C1C">

    <LinearLayout
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/lp_kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:letterSpacing="0.08"
            android:text="LAST"
            android:textColor="#0095F6"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lp_age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="3h 12m ago"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Declared for id parity; hidden at this size. -->
        <TextView
            android:id="@+id/lp_when"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="" />

        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_notice"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:visibility="gone"
        android:text="Open Oreamnos to update this widget"
        android:textColor="#B0B3B8"
        android:textSize="10sp" />
</LinearLayout>
