<?xml version="1.0" encoding="utf-8"?>
<!-- Engagement, row (one cell tall): three inline numbers, no footer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="#1C1C1C">

    <LinearLayout
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Declared for id parity; the provider keeps the one-row strip inline. -->
        <LinearLayout
            android:id="@+id/eng_rate_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/eng_rate_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4%"
                android:textColor="#0095F6"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/eng_rate_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:text="eng. rate"
                android:textColor="#B0B3B8"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/eng_kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:letterSpacing="0.08"
            android:text="LAST"
            android:textColor="#0095F6"
            android:textSize="9sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextView
                android:id="@+id/eng_r_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="128"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/eng_r_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:text="reactions"
                android:textColor="#B0B3B8"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/eng_c_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:maxLines="1"
                android:text="24"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/eng_c_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:text="comments"
                android:textColor="#B0B3B8"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/eng_s_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:maxLines="1"
                android:text="9"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/eng_s_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:text="shares"
                android:textColor="#B0B3B8"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/eng_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="2h"
            android:textColor="#B0B3B8"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/eng_caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="" />

        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_notice"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:visibility="gone"
        android:text="Open Oreamnos to update this widget"
        android:textColor="#B0B3B8"
        android:textSize="10sp" />
</LinearLayout>
