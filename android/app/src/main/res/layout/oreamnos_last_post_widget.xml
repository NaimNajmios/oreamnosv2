<?xml version="1.0" encoding="utf-8"?>
<!-- Last post, expanded (4x2): relative age with the absolute instant. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="#1C1C1C">

    <LinearLayout
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lp_kicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:letterSpacing="0.08"
            android:text="LAST POST"
            android:textColor="#0095F6"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lp_age"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="3h 12m ago"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lp_when"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Today 20:14"
            android:textColor="#B0B3B8"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text=""
            android:textColor="#B0B3B8"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_notice"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:visibility="gone"
        android:text="Open Oreamnos to update this widget"
        android:textColor="#B0B3B8"
        android:textSize="11sp" />
</LinearLayout>
