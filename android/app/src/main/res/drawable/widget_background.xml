<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded widget surface. The provider tints the solid colour from the
     active app palette on API 31+; below that a rounded drawable would be
     clipped by older launchers anyway, so the provider uses a flat colour. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1C1C1C" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#33B0B3B8" />
</shape>
